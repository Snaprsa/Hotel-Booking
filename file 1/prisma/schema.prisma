// Prisma Schema for Hotel Booking System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// USER AUTHENTICATION & SESSIONS
// ========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          UserRole  @default(CUSTOMER)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  properties    Property[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]

  @@map("users")
}

enum UserRole {
  ADMIN
  HOST
  CUSTOMER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========================================
// PROPERTY LISTINGS
// ========================================

model Property {
  id                String      @id @default(cuid())
  title             String
  description       String      @db.Text
  propertyType      PropertyType
  address           String
  city              String
  state             String
  country           String
  zipCode           String?
  latitude          Float?
  longitude         Float?

  // Property Details
  maxGuests         Int
  bedrooms          Int
  beds              Int
  bathrooms         Float
  squareFeet        Int?

  // Pricing
  pricePerNight     Float
  cleaningFee       Float       @default(0)
  serviceFee        Float       @default(0)
  currency          String      @default("USD")

  // Availability
  instantBook       Boolean     @default(false)
  minNights         Int         @default(1)
  maxNights         Int?

  // Status
  isActive          Boolean     @default(true)
  isFeatured        Boolean     @default(false)
  viewCount         Int         @default(0)

  // Host
  hostId            String
  host              User        @relation(fields: [hostId], references: [id])

  // Timestamps
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  // Relations
  images            PropertyImage[]
  amenities         PropertyAmenity[]
  categories        PropertyCategory[]
  bookings          Booking[]
  reviews           Review[]
  blockedDates      BlockedDate[]

  @@map("properties")
  @@index([propertyType])
  @@index([city])
  @@index([isActive])
}

enum PropertyType {
  HOTEL
  APARTMENT
  VILLA
  COTTAGE
  CABIN
  RESORT
  GUESTHOUSE
  HOSTEL
  EXPERIENCE
  CAR
  FLIGHT
}

model PropertyImage {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  isCover    Boolean  @default(false)
  order      Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("property_images")
}

model Amenity {
  id          String            @id @default(cuid())
  name        String            @unique
  icon        String?
  category    AmenityCategory   @default(GENERAL)
  properties  PropertyAmenity[]

  @@map("amenities")
}

enum AmenityCategory {
  GENERAL
  BATHROOM
  BEDROOM
  KITCHEN
  ENTERTAINMENT
  OUTDOOR
  SAFETY
  ACCESSIBILITY
}

model PropertyAmenity {
  id         String   @id @default(cuid())
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@unique([propertyId, amenityId])
  @@map("property_amenities")
}

model Category {
  id         String             @id @default(cuid())
  name       String             @unique
  slug       String             @unique
  icon       String?
  properties PropertyCategory[]

  @@map("categories")
}

model PropertyCategory {
  id         String   @id @default(cuid())
  propertyId String
  categoryId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([propertyId, categoryId])
  @@map("property_categories")
}

model BlockedDate {
  id         String   @id @default(cuid())
  propertyId String
  date       DateTime
  reason     String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@map("blocked_dates")
}

// ========================================
// BOOKINGS
// ========================================

model Booking {
  id                String        @id @default(cuid())

  // Guest Information
  guestId           String
  guest             User          @relation(fields: [guestId], references: [id])
  guestName         String
  guestEmail        String
  guestPhone        String

  // Property
  propertyId        String
  property          Property      @relation(fields: [propertyId], references: [id])

  // Dates
  checkIn           DateTime
  checkOut          DateTime
  nights            Int

  // Guests
  adults            Int
  children          Int           @default(0)
  infants           Int           @default(0)
  totalGuests       Int

  // Pricing
  pricePerNight     Float
  totalNights       Float
  cleaningFee       Float
  serviceFee        Float
  totalPrice        Float
  currency          String        @default("USD")

  // Status
  status            BookingStatus @default(PENDING)

  // Special Requests
  specialRequests   String?       @db.Text

  // Cancellation
  cancellationReason String?      @db.Text
  cancelledAt       DateTime?
  refundAmount      Float?

  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  payment           Payment?
  notifications     BookingNotification[]

  @@map("bookings")
  @@index([guestId])
  @@index([propertyId])
  @@index([status])
  @@index([checkIn])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  COMPLETED
}

// ========================================
// PAYMENTS
// ========================================

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id])

  amount            Float
  currency          String        @default("USD")
  status            PaymentStatus @default(PENDING)

  // Stripe
  stripePaymentId   String?       @unique
  stripeClientSecret String?

  // Payment Method
  paymentMethod     String?       // "card", "paypal", etc.
  last4             String?

  // Timestamps
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("payments")
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// ========================================
// REVIEWS & RATINGS
// ========================================

model Review {
  id          String   @id @default(cuid())

  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  rating      Float    // 1-5
  title       String?
  comment     String   @db.Text

  // Sub-ratings
  cleanliness Float?
  accuracy    Float?
  checkIn     Float?
  communication Float?
  location    Float?
  value       Float?

  isPublished Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
  @@index([propertyId])
  @@index([userId])
}

// ========================================
// NOTIFICATIONS
// ========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?

  isRead    Boolean          @default(false)
  readAt    DateTime?

  createdAt DateTime         @default(now())

  @@map("notifications")
  @@index([userId, isRead])
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
}

model BookingNotification {
  id          String               @id @default(cuid())
  bookingId   String
  booking     Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  type        NotificationChannel
  recipient   String               // email or phone
  subject     String?
  message     String               @db.Text

  status      NotificationStatus   @default(PENDING)
  sentAt      DateTime?
  error       String?              @db.Text

  // External IDs
  emailId     String?              // Resend email ID
  whatsappId  String?              // Twilio message SID

  createdAt   DateTime             @default(now())

  @@map("booking_notifications")
  @@index([bookingId])
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

// ========================================
// ADMIN & ANALYTICS
// ========================================

model Analytics {
  id            String   @id @default(cuid())
  date          DateTime @unique

  totalBookings Int      @default(0)
  totalRevenue  Float    @default(0)
  totalUsers    Int      @default(0)
  totalProperties Int    @default(0)

  createdAt     DateTime @default(now())

  @@map("analytics")
}
